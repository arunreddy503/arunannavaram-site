---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Arun Annavaram">
  <main class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-5xl font-bold tracking-tight">Hi, I'm Arun.</h1>
    <p class="mt-4 text-xl text-slate-600 dark:text-slate-300">
      Application Support Engineer (L3), growing into SRE &amp; DevOps.
    </p>
    <p class="mt-4 text-slate-600 dark:text-slate-300">
      I keep production running, and I'm learning to build systems that don't need me at 3 AM.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/work" class="rounded-lg bg-slate-900 px-5 py-3 text-white hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">See my work</a>
      <a href="/contact" class="rounded-lg border border-slate-300 px-5 py-3 hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-900">Say hello</a>
    </div>

    <div class="mt-16 grid gap-6 border-t border-slate-200 pt-8 text-sm dark:border-slate-800 sm:grid-cols-2">
      <div>
        <p class="font-semibold">Professional</p>
        <p class="mt-2 text-slate-600 dark:text-slate-300">
          7.5+ years in IT · Jira Cloud administration · access management · Level 3 support
        </p>
      </div>
      <div>
        <p class="font-semibold">Learning</p>
        <p class="mt-2 text-slate-600 dark:text-slate-300">
          Linux · Python for automation · Docker · Kubernetes · cloud
        </p>
      </div>
    </div>
  </main>
</Layout>