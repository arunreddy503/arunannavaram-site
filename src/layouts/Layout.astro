---
import '../styles/global.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <header class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
      <a href="/" class="font-semibold">Arun Annavaram</a>
      <nav class="flex gap-6 text-sm text-slate-600 dark:text-slate-300">
        <a href="/about">About</a>
        <a href="/work">Work</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>
    <slot />
    <footer class="mx-auto max-w-3xl px-6 py-10 text-sm text-slate-500">
      © 2026 Arun Reddy Annavaram
    </footer>
  </body>
</html>
